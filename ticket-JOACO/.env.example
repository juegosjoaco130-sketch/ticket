# Dely - Ejemplo de variables de entorno.
# Copiar a ".env" (sin subirlo al repositorio) y completar los valores:
#   cp .env.example .env
#
# El archivo .env lo usa docker-compose.yml (env_file) para el backend
# y para inicializar MySQL. Nunca incluirlo en Git.

# Conexión que usa el backend (Backend/config/Parametros.php).
# DB_HOST debe ser el nombre del servicio MySQL en Docker.
DB_HOST=mysql
DB_PORT=3306

# Base de datos y usuarios de MySQL.
DB_NAME=dely
DB_USER=dely_user
DB_PASSWORD=cambiar_esta_clave
DB_ROOT_PASSWORD=cambiar_clave_root
